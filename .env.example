# Server
PORT=3000

# Admin login aman dari backend. Password tidak ditanam di HTML.
ADMIN_EMAIL=admin@everastore.id
ADMIN_PASSWORD=ganti_password_ini
# Alternatif lebih aman: kosongkan ADMIN_PASSWORD dan isi hash SHA-256 password.
# ADMIN_PASSWORD_SHA256=

# Sakurupiah
# Production: https://sakurupiah.id/api/
# Sandbox: https://sakurupiah.id/api-sanbox/
SAKURUPIAH_BASE_URL=https://sakurupiah.id/api-sanbox/
SAKURUPIAH_API_ID=isi_api_id_merchant
SAKURUPIAH_API_KEY=isi_api_key_merchant
SAKURUPIAH_CALLBACK_URL=https://domain-kamu.com/api/payments/callback
SAKURUPIAH_RETURN_URL=https://domain-kamu.com/payment-selesai
SAKURUPIAH_EXPIRED_HOURS=24
# 1 = fee ditanggung merchant, 2 = fee ditanggung customer
SAKURUPIAH_MERCHANT_FEE=1
